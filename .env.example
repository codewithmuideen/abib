# Resend API key (https://resend.com/api-keys). Server-side only. Never expose to the browser.
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g. "Abib Website <website@abibltd.co.uk>"
RESEND_FROM_EMAIL=

# Recipients
CONTACT_EMAIL=info@abibltd.co.uk
HR_EMAIL=hr@abibltd.co.uk

# Server
PORT=3001
# Number of reverse proxies in front of Node (e.g. 1 behind Nginx/Render/Railway) so rate limiting sees real IPs.
TRUST_PROXY=

# Private First Week Review links
# Long random secret used to sign personal review links (at least 32 characters). Changing it cancels every link.
#   Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVIEW_LINK_SECRET=
# Password HR uses on /review-links to create links (at least 10 characters).
ADMIN_PASSWORD=
# Optional: base URL used in generated links, e.g. https://www.abibltd.co.uk
SITE_URL=
